@startuml 

' PATRON SINGLETON

' CLASE PRINCIPAL DEL PATRON.
class Singleton {
    ' Atributos privado que almancena la unica instancia de Singleton.
    {static} - instancia : Singleton
    ' Constructor privado para evitar que se creen instancias desde otra clase.
    - Singleton()
    ' Permite obtener la unica instancia de Singleton.
    {static} + obtenerInstancia() : Singleton
    ' Metodo de ejemplo de la clase.
    + ejecutarSingleton() : void
}

' La clase mantiene referencia a su propia instancia para garantizar que existe una unica instancia.
Singleton -> Singleton : mantiene unica instancia  

@enduml 
